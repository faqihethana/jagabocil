{
  "name": "@jagabocil/server",
  "version": "1.0.0",
  "description": "API keluarga, rekaman ngaji, dan izin remote TV JagaBocil",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx watch --use-env-proxy --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc",
    "start": "node --use-env-proxy --env-file-if-exists=.env --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --use-env-proxy --env-file-if-exists=.env.local src/migrate.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@ai-sdk/google": "^4.0.121",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@neondatabase/serverless": "^1.2.1",
    "@smithy/fetch-http-handler": "^5.8.1",
    "ai": "^7.0.173",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.5.0"
  }
}
