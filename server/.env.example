HOST=0.0.0.0
PORT=8787
DATA_DIR=./data
# Opsional: tanpa DATABASE_URL, mode lokal memakai SQLite.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_SCHEMA=jagabocil
DATABASE_AUTO_MIGRATE=false
# local untuk pengembangan; s3 untuk rekaman di bucket bersama.
AUDIO_STORE=local
AWS_REGION=ap-southeast-3
AWS_S3_BUCKET_NAME=faqih-ethana-general-bucket
AWS_S3_PREFIX=jagabocil/production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Opsional. Tanpa key, mode manual tetap berfungsi.
GEMINI_API_KEY=
AI_MODEL=gemini-4-hydrogen
